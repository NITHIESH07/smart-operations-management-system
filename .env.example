
# MongoDB Database Connection String
MONGODB_URI="mongodb://localhost:27017/smart_operations_db"

# JWT Configuration
JWT_SECRET="replace_with_a_secure_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Optional Admin Registration Secret (for provisioning initial admin account securely)
ADMIN_REGISTRATION_SECRET="admin_secret_key_for_setup"
